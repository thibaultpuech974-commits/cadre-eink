// Configuration du deploiement automatique (Cloudflare Workers Builds) :
// a chaque envoi sur la branche main, Cloudflare deploie serveur/worker.js.
// Le secret CLE n'est pas ici : il reste dans le tableau de bord Cloudflare.
{
  "name": "cadre",
  "main": "serveur/worker.js",
  "compatibility_date": "2025-09-01",
  "kv_namespaces": [
    { "binding": "CADRE", "id": "4fcf3dab2bf546afaf545285acf10935" }
  ],
  // garde les variables saisies dans le tableau de bord
  "keep_vars": true,
  // Journaux du Worker (Workers & Pages -> cadre -> Observabilite) : les messages du serveur (source
  // en panne, copie de secours utilisee, erreur d'une route, alerte envoyee) sont gardes 3 jours,
  // au lieu d'etre perdus si personne ne regarde en direct. Gratuit jusqu'a 200 000 lignes par jour.
  "observability": { "enabled": true },
  // Une fois par heure (a la minute 7) : le serveur verifie s'il doit envoyer une alerte sur l'iPhone
  // (cadre muet, batterie faible, horaires de bus perimes ; voir serveur/alertes.js)
  "triggers": { "crons": ["7 * * * *"] },
  // les morceaux de la page web (serveur/page/*.html) sont importes comme du texte
  // et le dessin de la carte en WebAssembly (serveur/apercu.wasm) comme des octets, envoyes tels quels a la page
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/apercu.wasm"] }
  ]
}
